[Unit]
Description=TTS Worker (VieNeu for Vietnamese + edge-tts for other languages)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/app/tts-worker
EnvironmentFile=/root/app/tts-worker/.env
ExecStart=/root/app/tts-worker/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8004
Restart=always
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
