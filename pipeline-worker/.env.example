# pipeline-worker — translation pipeline (download → Gemini → TTS → mux)
# Copy to .env on the VPS. Never commit the real .env.

HOST=0.0.0.0
PORT=8006
LOG_LEVEL=info

# --- Auth — HMAC. Shares HMAC_KEYS_JSON with tts-worker/video-worker so one rotation covers all ---
HMAC_KEYS_JSON={"key-id-1":"REPLACE_WITH_A_LONG_RANDOM_SECRET"}
HMAC_MAX_SKEW_SECONDS=60
HMAC_NONCE_TTL_SECONDS=300
REQUEST_MAX_BODY_BYTES=2097152

# --- Upstream workers (loopback on the VPS, via Caddy or direct) ---
VIDEO_WORKER_URL=http://127.0.0.1:8005
TTS_WORKER_URL=http://127.0.0.1:8004

# --- Gemini (transcription/translation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Object storage — S3-compatible (AWS S3 / Cloudflare R2) — see plan/009 §5.2 ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_RETENTION_DAYS=7
PRESIGN_TTL_SECONDS=900

# --- Work dirs ---
WORK_DIR=/data/pipeline-output
CACHE_DIR=/data/pipeline-cache
FFMPEG_BIN=ffmpeg
PIPELINE_CONCURRENCY=1

# --- Cache-aside (plan/009 T1.5) — Gemini + TTS results ---
CACHE_TTL_SECONDS=604800
CACHE_MAX_SIZE_MB=2048
CACHE_MAX_FILES=5000

# --- Chunking (plan/009 T1.3) ---
CHUNK_DURATION_SECONDS=510
GEMINI_PARALLEL=3

# --- Subtitle detection (plan/009 T3.2) ---
SUBTITLE_SAMPLE_FPS=1
SUBTITLE_MAX_SAMPLES=30
SUBTITLE_STABLE_RATIO=0.6

# --- Queue / resilience (plan/009 T5.x, T2.5) ---
QUEUE_MAX_DEPTH=100
MAX_RETRIES=3
MAX_ELAPSED_SECONDS=120
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60
MAX_CONCURRENT_PER_USER=2

# --- Cleanup / disk guard (plan/009 T5.2) ---
CLEANUP_INTERVAL_SECONDS=600
WORK_DIR_TTL_SECONDS=86400
DISK_MIN_FREE_MB=5120

# --- Stall watchdog — turn silent hangs into explicit errors ---
# A queued job older than QUEUE_TIMEOUT_SECONDS fails with QUEUE_TIMEOUT; a job
# with no progress for JOB_TIMEOUT_SECONDS fails with JOB_TIMEOUT; and if the
# scheduler itself is down, queued jobs fail immediately with SCHEDULER_DOWN.
WATCHDOG_INTERVAL_SECONDS=15
QUEUE_TIMEOUT_SECONDS=900
JOB_TIMEOUT_SECONDS=1800

# --- Operations ---
REQUEST_ID_HEADER=X-Request-Id
ACCESS_LOG_ENABLED=true
