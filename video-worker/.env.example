# Runtime config for the video-worker container/service.
# Copy to .env on the VPS. Never commit the real .env.

# Application
HOST=0.0.0.0
PORT=8005
LOG_LEVEL=info

# Auth — HMAC. The API signs each request with the X-Video-* headers.
# Share the same key store as the TTS worker so one rotation covers both.
HMAC_KEYS_JSON={"key-id-1":"REPLACE_WITH_A_LONG_RANDOM_SECRET"}
HMAC_MAX_SKEW_SECONDS=60
HMAC_NONCE_TTL_SECONDS=300
REQUEST_MAX_BODY_BYTES=65536

# Limits / concurrency
VIDEO_CONCURRENCY=2
MAX_FILESIZE_MB=500
YTDLP_TIMEOUT_SECONDS=600
VIDEO_INFO_TIMEOUT_SECONDS=60
VIDEO_OUTPUT_DIR=/data/output

# Cookie store (see scripts/cookiectl + scripts/export-brave-cookies.sh)
# One Netscape jar per platform plus combined.txt, read at request time.
COOKIE_DIR=/data/cookies
COOKIE_STALE_DAYS=14
# Optional webhook fired by `cookiectl check` when a cookie goes stale
COOKIE_ALERT_WEBHOOK=

# Binaries
FFMPEG_BIN=ffmpeg

# Extra allowlisted domains (comma separated), on top of the built-in platforms
ALLOWED_PLATFORMS=

# Optional: yt-dlp proxy (needed for Douyin from a non-China IP)
YT_DLP_PROXY=

# Optional: dedicated proxy for ALL Douyin traffic (all three download tiers:
# douyin-downloader, f2, yt-dlp). Douyin 403s non-China datacenter IPs even
# with fresh cookies, so set this to a residential / China proxy. Leave empty
# to use the server's direct IP. Other platforms ignore this var.
DOUYIN_PROXY=

# Optional: fetch cookies straight from a browser profile on the same host.
# Leave unset on the VPS — use the cookie store instead.
YT_DLP_BROWSER=

# Object storage — R2 (S3-compatible, used for presigned URLs to bypass Vercel 4.5MB limit)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=video-translator
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_RETENTION_DAYS=7
PRESIGN_TTL_SECONDS=900
