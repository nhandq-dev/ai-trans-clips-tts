# Application
APP_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8004
DISABLE_DOCS=false
# Leave empty in development. Required in production when docs are enabled; it protects
# /docs, /redoc and /openapi.json with HTTP Basic auth.
DOCS_PASSWORD=

# TTS runtime
MAX_TEXT_LENGTH=5000
SYNC_MAX_TEXT_LENGTH=2000
TTS_CONCURRENCY=2
TTS_FORMAT=mp3
TTS_OUTPUT_DIR=tts_output
# HF_HOME=/data/hf-cache
FFMPEG_BIN=ffmpeg

# VieNeu (Vietnamese) — on-device ONNX backend, no torch needed
VIENEU_BACKEND=onnx
VIENEU_DEFAULT_VOICE=Adam
VIENEU_CHUNK_CHARS=280

# Custom (cloned) Vietnamese voices
CUSTOM_VOICE_ENABLED=true
CUSTOM_VOICE_MIN_SECONDS=8
CUSTOM_VOICE_MAX_SECONDS=10
CUSTOM_VOICE_MAX=3
CUSTOM_VOICE_PREFIX=custom-voices
FFPROBE_BIN=ffprobe

# Object storage (S3-compatible; Cloudflare R2 in production). Leave blank to disable
# custom voices. For R2: S3_REGION=auto, S3_FORCE_PATH_STYLE=true,
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true

# Kokoro-82M (all languages except Vietnamese) — on-device ONNX TTS, replaces edge-tts.
# Model dir for kokoro-v1.0.onnx + voices-v1.0.bin; blank = under HF_HOME/kokoro/.
# KOKORO_MODEL_DIR=
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_CHUNK_CHARS=500
KOKORO_SPEED=1.0
# First run auto-downloads the model (~330MB) from the official GitHub release;
# override the URLs for air-gapped deploys. Warmed up at boot when READINESS_WARMUP=true.
# KOKORO_MODEL_URL=
# KOKORO_VOICES_URL=

# Security — HMAC_KEYS_JSON is a JSON map of {keyId: secret}
HMAC_KEYS_JSON={"local-dev":"change-me-to-a-long-random-string"}
HMAC_MAX_SKEW_SECONDS=60
HMAC_NONCE_TTL_SECONDS=300
# Allows an 8–10s reference upload plus base64/multipart overhead.
REQUEST_MAX_BODY_BYTES=6291456

# Operations
REQUEST_ID_HEADER=X-Request-Id
ACCESS_LOG_ENABLED=true
# Load the VieNeu model at boot so the first request does not pay ~9s of cold start
READINESS_WARMUP=true
