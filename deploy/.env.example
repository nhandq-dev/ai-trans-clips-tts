# Runtime configuration for the tts-worker container.
# Copy to .env on the VPS and fill in real values. Never commit the real .env.

# Application
APP_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8004
DISABLE_DOCS=false
# Required while docs are enabled in production; protects /docs, /redoc, /openapi.json (Basic auth)
DOCS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# TTS runtime
MAX_TEXT_LENGTH=5000
SYNC_MAX_TEXT_LENGTH=2000
TTS_CONCURRENCY=2
TTS_FORMAT=mp3
TTS_OUTPUT_DIR=/data/output
HF_HOME=/data/hf-cache
FFMPEG_BIN=ffmpeg

# VieNeu (Vietnamese)
VIENEU_BACKEND=onnx
VIENEU_DEFAULT_VOICE=Adam
VIENEU_CHUNK_CHARS=280

# Custom (cloned) Vietnamese voices
CUSTOM_VOICE_ENABLED=true
CUSTOM_VOICE_MIN_SECONDS=8
CUSTOM_VOICE_MAX_SECONDS=10
CUSTOM_VOICE_MAX=3
CUSTOM_VOICE_PREFIX=custom-voices
FFPROBE_BIN=ffprobe

# Object storage (S3-compatible; Cloudflare R2). Required for custom voices.
# For R2: S3_REGION=auto, S3_FORCE_PATH_STYLE=true,
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_R2_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
S3_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true

# edge-tts (other languages)
EDGE_FALLBACK_VOICE=en-US-JennyNeural
EDGE_CHUNK_CHARS=300

# Security — replace with long random secrets; rotate with dual-key support
HMAC_KEYS_JSON={"key-id-1":"REPLACE_WITH_A_LONG_RANDOM_SECRET"}
HMAC_MAX_SKEW_SECONDS=60
HMAC_NONCE_TTL_SECONDS=300
# Allows an 8–10s reference upload plus multipart overhead.
REQUEST_MAX_BODY_BYTES=6291456

# Operations
REQUEST_ID_HEADER=X-Request-Id
ACCESS_LOG_ENABLED=true
# Load the VieNeu model at boot so the first request does not pay ~9s of cold start
READINESS_WARMUP=true

# Deploy (used by docker compose for image tag interpolation)
IMAGE_TAG=latest

# ----- video-worker (shares HMAC_KEYS_JSON with tts-worker) -----
# See video-worker/.env.example for all options. These must match /opt/video-worker/.env
# so Vercel can sign requests for both workers with one key rotation.
# VIDEO_WORKER_URL is set in Vercel (e.g. https://tts-api.aitransclips.com/video)
VIDEO_IMAGE_TAG=latest
VIDEO_CONCURRENCY=2
