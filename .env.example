HOST=0.0.0.0
PORT=8004
CORS_ALLOW_ORIGINS=*
TTS_WORKER_SECRET=change-me-to-a-long-random-string

TTS_CONCURRENCY=2
MAX_TEXT_LENGTH=5000
TTS_FORMAT=mp3
TTS_OUTPUT_DIR=tts_output

# VieNeu (Vietnamese) — on-device ONNX backend, no torch needed
VIENEU_BACKEND=onnx
VIENEU_DEFAULT_VOICE=Adam
VIENEU_CHUNK_CHARS=280

# edge-tts (all other languages)
EDGE_FALLBACK_VOICE=en-US-JennyNeural
EDGE_CHUNK_CHARS=300

FFMPEG_BIN=ffmpeg
