# Caddy terminates TLS for tts-api.aitransclips.com.
#
# Both Python workers live on the same host and are published only on loopback,
# so Caddy (a host systemd service) reaches them without exposing container
# ports. They share one hostname and are separated by path prefix;
# `handle_path` strips the prefix before proxying, so each worker keeps its own
# unprefixed routes.
#
# The API signs the path the worker sees (post-strip), so pointing
# VIDEO_WORKER_URL at https://tts-api.aitransclips.com/video needs no code change.
#
# NOTE: /opt/tts-worker/scripts/provision.sh installs its own copy of this file
# over /etc/caddy/Caddyfile. If it is ever re-run, re-add the /video block.

tts-api.aitransclips.com {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	# Video download worker (loopback :8005). handle_path strips /video.
	# Longer header timeout: a download can take minutes.
	handle_path /video/* {
		reverse_proxy 127.0.0.1:8005 {
			transport http {
				dial_timeout 2s
				response_header_timeout 600s
			}
		}
	}

	# Everything else → TTS worker (loopback :8004).
	handle {
		reverse_proxy 127.0.0.1:8004 {
			transport http {
				dial_timeout 2s
				response_header_timeout 90s
			}
		}
	}

	log {
		output file /var/log/caddy/tts-api.access.log
		format json
	}
}
